<UserControl x:Class="SaleInvoice.FaturaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SaleInvoice"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Butoni -->
        </Grid.RowDefinitions>
        
        <DataGrid x:Name="dgFatura"
                  AutoGenerateColumns="True"
                  Margin="10"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <!-- Kolona Ndrysho -->
                <DataGridTemplateColumn Header="Ndrysho">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Ndrysho"
                                    Padding="5"
                                    Margin="5"
                                    Click="BtnEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Kolona Fshij -->
                <DataGridTemplateColumn Header="Fshij">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Fshij"
                                    Padding="5"
                                    Margin="5"
                                    Background="Red"
                                    Foreground="White"
                                    Click="BtnDelete_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1"
             Orientation="Horizontal"
             HorizontalAlignment="Right"
             Margin="10">

            <Button Content="Shto"
                     Width="120"
                     Padding="5"
                     Click="BtnAdd_Click">

            </Button>
        </StackPanel>
    </Grid>
</UserControl>
