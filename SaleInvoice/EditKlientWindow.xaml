<Window x:Class="SaleInvoice.EditKlientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SaleInvoice"
        mc:Ignorable="d"
        Title="EditKlientWindow" Height="600" Width="400">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <Label Content="ID (Nipt)" />
            <TextBox x:Name="txtId" Margin="5" IsReadOnly="True"/>

            <Label Content="Emri" />
            <TextBox x:Name="txtEmri" Margin="5"/>

            <Label Content="Kodi" />
            <TextBox x:Name="txtKodi" Margin="5"/>

            <Label Content="Shteti" />
            <ComboBox x:Name="cmbShteti" Margin="5">
                <ComboBoxItem Content="Shqiperi"/>
                <ComboBoxItem Content="Kosove"/>
                <ComboBoxItem Content="Maqedoni"/>
                <ComboBoxItem Content="Tjeter"/>
            </ComboBox>

            <Label Content="Qyteti" />
            <ComboBox x:Name="cmbQyteti" Margin="5">
                <ComboBoxItem Content="Tirane"/>
                <ComboBoxItem Content="Durres"/>
                <ComboBoxItem Content="Vlorë"/>
                <ComboBoxItem Content="Shkoder"/>
            </ComboBox>

            <Label Content="Email" />
            <TextBox x:Name="txtEmail" Margin="5"/>

            <Label Content="Tel" />
            <TextBox x:Name="txtTel" Margin="5"/>

            
            <Label Content="Llogaria Kontabel" />
            <ComboBox x:Name="cmbLlogariaKontabel" Margin="5">
                <ComboBoxItem Content="Banka 1"/>
                <ComboBoxItem Content="Banka 2"/>
                <ComboBoxItem Content="Banka 3"/>
            </ComboBox>

           
            <Label Content="Barcode" />
            <TextBox x:Name="txtBarcode" Margin="5"/>

           
            <Label Content="Lista e Çmimeve" />
            <ComboBox x:Name="cmbListaCmimeve" Margin="5">
                <ComboBoxItem Content="Cmimet A"/>
                <ComboBoxItem Content="Cmimet B"/>
                <ComboBoxItem Content="Cmimet C"/>
            </ComboBox>

           
            <Label Content="Adresa" />
            <TextBox x:Name="txtAdresa" Margin="5"/>

            <Label Content="Note" />
            <TextBox x:Name="txtNote" Margin="5"/>

           
            <Button Content="Ruaj Ndryshimet" Margin="10" Padding="5" Click="BtnSave_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
