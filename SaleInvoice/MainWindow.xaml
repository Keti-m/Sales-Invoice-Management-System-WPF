<Window x:Class="SaleInvoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SaleInvoice"
        mc:Ignorable="d"
        Title="Dashboard" Height="450" Width="800">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="LightBlue"
                   Height="50">
            <Button x:Name="btnKliente" Content="Kliente"
                    Width="90" Margin="10"/>
            <Button x:Name="btnArtikuj" Content="Artikuj"
         Width="90" Margin="10"/>
            <Button x:Name="btnFatura" Content="Fatura"
         Width="90" Margin="10"/>
        </StackPanel>

        <Grid x:Name="ContentGrid"/>
    </DockPanel>
</Window>
